# Copy to backend/.env (gitignored) and fill in what you have.
# Every key is optional: without them the app prices trips from labeled
# estimates. See README → "API keys".

# Real flight fares + flight times. Free test-mode key at duffel.com
# (starts with duffel_test_). Issue #7.
DUFFEL_API_KEY=

# Fuel prices from gas stations near the origin. Google Cloud key with
# "Places API (New)" enabled; ~1,000 free lookups/month. Issue #2.
GOOGLE_PLACES_API_KEY=

# Optional: U.S. government weekly fuel averages (ranked below Google).
EIA_API_KEY=

# Infrastructure: unset = SQLite file + in-memory cache (zero setup).
# docker compose sets these to its own Postgres and Redis.
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/fareenough
# REDIS_URL=redis://localhost:6379/0
